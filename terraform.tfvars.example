subscription_id     = "00000000-0000-0000-0000-000000000000"
prefix              = "myapps"
resource_group_name = null # Defaults to "<prefix>-rg" (max 83 chars); backup is the exact name plus "-backup".
location            = "southeastasia"
vm_size             = "Standard_D2as_v5"
vm_name             = "myapps-vm"
disk_size_gb        = 64
data_disk_count     = 4
data_disk_size_gb   = 32
admin_cidr          = "0.0.0.0/0"
admin_username      = "azadmin"
ssh_port            = 22222
# Set ssh_public_key directly, or omit it to read ssh_public_key_path.
# ssh_public_key      = "ssh-ed25519 AAAAC3... admin@example.com"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
acme_email          = "admin@example.com"
backup_time_zone    = "Asia/Shanghai"
github_repositories = ["owner/app-a", "owner/app-b"]
# Repositories using GitHub immutable OIDC subjects must also provide their
# numeric owner/repository IDs from the repository OIDC settings API.
github_repository_ids = {
  "owner/app-a" = {
    owner_id      = "123456"
    repository_id = "789012"
  }
}
